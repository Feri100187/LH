# Preserve committed bytes across Windows/macOS/Linux checkouts. Asset locks include
# .meta, shaders and JSON; automatic CRLF conversion would change their hashes.
* -text

*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.lm filter=lfs diff=lfs merge=lfs -text
*.lani filter=lfs diff=lfs merge=lfs -text
*.ltcb filter=lfs diff=lfs merge=lfs -text
